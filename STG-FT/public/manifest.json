{
  "manifest_version": 3,
  "name": "STG AI",
  "version": "1.0",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": ["activeTab", "scripting","storage"],



  "content_scripts": [
  {
    "matches": ["<all_urls>"],
    "js": [
    "Detection/Login-d.js",
    "Detection/Tracker-d.js",
    "Detection/Trackscore-d.js",
  "Content.js"]
  }
],
 "host_permissions": [
   "http://127.0.0.1:8000/*"
  ]
}

